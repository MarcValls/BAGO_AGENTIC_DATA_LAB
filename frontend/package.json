{
  "name": "bago-portfolio-ui",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "vitest run",
    "test:providers": "vitest run tests/providers/provider-settings.test.tsx",
    "test:ui": "node --test tests/ui/agent-evaluation-lab/agent-evaluation-lab.test.mjs tests/ui/agent-evaluation-lab/rendered.test.mjs tests/ui/agent-runner/agent-runner.test.mjs tests/ui/capabilities/mcp-governance.test.mjs tests/ui/chat-shell/chat-navigation.test.mjs tests/ui/knowledge/catalog-quality.test.mjs tests/ui/knowledge/grounded-source.test.mjs tests/ui/knowledge/ontology-review.test.mjs",
    "test:contracts": "node --test tests/contracts/node-contracts.test.mjs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^22.1.0",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
