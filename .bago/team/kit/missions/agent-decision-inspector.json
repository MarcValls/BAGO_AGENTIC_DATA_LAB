{
  "mission_id": "AGENT_DECISION_INSPECTOR_V1",
  "title": "Agent Decision Inspector",
  "objective": "Build an interface that lets a human examine agent conclusions, claims, supporting evidence, provenance, confidence, traces, proposed actions, authorization state and execution receipts.",
  "max_concurrency": 3,
  "terminal_work_items": ["W12"],
  "work_items": [
    {
      "id": "W01",
      "title": "Freeze repository surface and identify reusable decision/evidence primitives",
      "role": "team-orchestrator",
      "depends_on": [],
      "write_scopes": [".bago/team/runtime/**", "docs/decision-inspector/inventory/**"],
      "read_scopes": ["**"],
      "deliverables": ["Repository snapshot", "Reuse map", "Boundary map"],
      "done_when": ["HEAD/snapshot recorded", "Existing evidence/receipt/trace/auth primitives mapped", "No architecture invented before reuse analysis"],
      "frozen_outputs": ["decision-inspector-reuse-map-v1"]
    },
    {
      "id": "W02",
      "title": "Define conclusion, claim, evidence and provenance contracts",
      "role": "evidence-provenance-engineer",
      "depends_on": ["W01"],
      "write_scopes": ["src/contracts/decision/**", "docs/decision-inspector/contracts/evidence/**", "tests/contracts/evidence/**"],
      "read_scopes": ["docs/decision-inspector/inventory/**", "src/**"],
      "deliverables": ["Conclusion schema", "Claim-to-evidence links", "Provenance contract", "Contract tests"],
      "done_when": ["Every conclusion can decompose into claims", "Every claim can link to zero or more evidence objects explicitly", "Evidence provenance and snapshot identity are representable", "Contract tests pass"],
      "frozen_outputs": ["decision-evidence-contract-v1"]
    },
    {
      "id": "W03",
      "title": "Define decision inspection UX and interaction model",
      "role": "decision-ux-engineer",
      "depends_on": ["W01"],
      "write_scopes": ["docs/decision-inspector/ux/**"],
      "read_scopes": ["docs/decision-inspector/inventory/**", "src/**"],
      "deliverables": ["Information architecture", "Drill-down flow", "Error/empty/loading states", "Accessibility requirements"],
      "done_when": ["Conclusion -> claim -> evidence -> provenance path defined", "Proposed action review path defined", "Uncertainty and missing evidence states are visible", "Keyboard/screen-reader requirements stated"],
      "frozen_outputs": ["decision-inspector-ux-contract-v1"]
    },
    {
      "id": "W04",
      "title": "Map traces and tool calls into inspectable timeline contract",
      "role": "trace-observability-engineer",
      "depends_on": ["W02"],
      "write_scopes": ["src/contracts/trace/**", "src/adapters/trace/**", "docs/decision-inspector/contracts/trace/**", "tests/contracts/trace/**"],
      "read_scopes": ["src/contracts/decision/**", "src/**"],
      "deliverables": ["Trace event schema", "Timeline adapter", "Correlation ids", "Trace contract tests"],
      "done_when": ["Agent/tool events correlate to claims/actions", "Chronology and causality are distinguishable", "Unknown/missing trace data fails visibly", "Tests pass"],
      "frozen_outputs": ["decision-trace-contract-v1"]
    },
    {
      "id": "W05",
      "title": "Define proposed action, authorization and receipt inspection contract",
      "role": "governance-action-engineer",
      "depends_on": ["W02"],
      "write_scopes": ["src/contracts/action/**", "src/adapters/action/**", "docs/decision-inspector/contracts/action/**", "tests/contracts/action/**"],
      "read_scopes": ["src/contracts/decision/**", "src/**"],
      "deliverables": ["Action proposal schema", "Authorization state model", "Approval/rejection reasons", "Execution receipt mapping"],
      "done_when": ["Capability, eligibility, authorization, availability and execution are not conflated", "Action risk/approval state is explicit", "Execution receipt links back to proposal", "Tests pass"],
      "frozen_outputs": ["decision-action-contract-v1"]
    },
    {
      "id": "W06",
      "title": "Build shared Decision Inspector shell and navigation",
      "role": "decision-ui-engineer",
      "depends_on": ["W02", "W03"],
      "write_scopes": ["src/features/decision-inspector/shell/**", "src/features/decision-inspector/shared/**", "tests/ui/decision-inspector/shell/**"],
      "read_scopes": ["src/contracts/decision/**", "docs/decision-inspector/ux/**", "src/**"],
      "deliverables": ["Inspector shell", "Selection state", "Shared status primitives", "Shell tests"],
      "done_when": ["A conclusion can be selected and navigated", "Shared states render deterministically", "No evidence/action/trace data is fabricated", "Tests pass"],
      "frozen_outputs": []
    },
    {
      "id": "W07",
      "title": "Build evidence and provenance explorer",
      "role": "decision-ui-engineer",
      "depends_on": ["W02", "W03", "W06"],
      "write_scopes": ["src/features/decision-inspector/evidence/**", "tests/ui/decision-inspector/evidence/**"],
      "read_scopes": ["src/contracts/decision/**", "docs/decision-inspector/ux/**", "src/features/decision-inspector/shared/**"],
      "deliverables": ["Claim tree", "Evidence viewer", "Provenance panel", "Missing-evidence states"],
      "done_when": ["Claim-to-evidence relation is inspectable", "Source/snapshot/provenance is visible", "Unsupported claims are visibly unsupported", "Tests pass"],
      "frozen_outputs": []
    },
    {
      "id": "W08",
      "title": "Build trace and tool-call timeline",
      "role": "decision-ui-engineer",
      "depends_on": ["W03", "W04", "W06"],
      "write_scopes": ["src/features/decision-inspector/trace/**", "tests/ui/decision-inspector/trace/**"],
      "read_scopes": ["src/contracts/trace/**", "docs/decision-inspector/ux/**", "src/features/decision-inspector/shared/**"],
      "deliverables": ["Trace timeline", "Tool-call details", "Correlation navigation"],
      "done_when": ["Timeline links to affected claim/action", "Tool inputs/outputs are inspectable subject to redaction", "Missing trace data is explicit", "Tests pass"],
      "frozen_outputs": []
    },
    {
      "id": "W09",
      "title": "Build proposed action and authorization review surface",
      "role": "decision-ui-engineer",
      "depends_on": ["W03", "W05", "W06"],
      "write_scopes": ["src/features/decision-inspector/actions/**", "tests/ui/decision-inspector/actions/**"],
      "read_scopes": ["src/contracts/action/**", "docs/decision-inspector/ux/**", "src/features/decision-inspector/shared/**"],
      "deliverables": ["Action proposal panel", "Authorization ladder", "Approve/reject/request-evidence controls", "Receipt viewer"],
      "done_when": ["Proposed action is distinct from executed action", "Authorization state is explicit", "Approval UI cannot imply execution without receipt", "Tests pass"],
      "frozen_outputs": []
    },
    {
      "id": "W10",
      "title": "Integrate evidence, trace and action surfaces",
      "role": "team-orchestrator",
      "depends_on": ["W07", "W08", "W09"],
      "write_scopes": ["src/features/decision-inspector/integration/**", "src/features/decision-inspector/index.*", "tests/ui/decision-inspector/integration/**"],
      "read_scopes": ["src/features/decision-inspector/**", "src/contracts/**"],
      "deliverables": ["Integrated inspector", "Cross-navigation", "End-to-end fixture"],
      "done_when": ["Conclusion -> evidence -> trace -> action -> receipt traversal works", "No cross-feature contract violations", "Integration tests pass"],
      "frozen_outputs": []
    },
    {
      "id": "W11",
      "title": "Run independent verification and adversarial review",
      "role": "verification-engineer",
      "depends_on": ["W10"],
      "write_scopes": ["tests/verification/decision-inspector/**", "docs/decision-inspector/verification/**"],
      "read_scopes": ["src/features/decision-inspector/**", "src/contracts/**", "tests/**", ".bago/team/runtime/handoffs/**"],
      "deliverables": ["Verification report", "Adversarial cases", "P0/P1/P2 findings"],
      "done_when": ["Unsupported-claim case tested", "Stale evidence case tested", "Unauthorized action case tested", "Missing receipt case tested", "No P0/P1 remains open"],
      "frozen_outputs": ["decision-inspector-verification-v1"]
    },
    {
      "id": "W12",
      "title": "Terminal mission gate",
      "role": "team-orchestrator",
      "depends_on": ["W11"],
      "write_scopes": [".bago/team/runtime/**", "docs/decision-inspector/FINAL_STATUS.md"],
      "read_scopes": [".bago/team/runtime/**", "docs/decision-inspector/**", "src/features/decision-inspector/**", "tests/**"],
      "deliverables": ["Final status", "Evidence index", "Known limitations"],
      "done_when": ["All dependency handoffs validate", "Independent verification has P0=0 and P1=0", "Final evidence index exists", "Residual P2/NOT_RUN items are explicit"],
      "frozen_outputs": ["agent-decision-inspector-v1-terminal-gate"]
    }
  ]
}
