{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bago://codex-team/work_item.schema.json",
  "type": "object",
  "required": ["id", "title", "role", "depends_on", "write_scopes", "deliverables", "done_when"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "role": {"type": "string"},
    "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "write_scopes": {"type": "array", "items": {"type": "string"}},
    "read_scopes": {"type": "array", "items": {"type": "string"}},
    "deliverables": {"type": "array", "items": {"type": "string"}},
    "done_when": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "frozen_outputs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
