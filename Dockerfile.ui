FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies
COPY requirements.txt requirements-whatsapp.txt requirements-documents.txt ./
RUN pip install --user --no-cache-dir -r requirements.txt -r requirements-documents.txt fastapi==0.136.1 uvicorn==0.46.0

# Build frontend
FROM node:22-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
COPY frontend/tsconfig*.json ./
COPY frontend/vite.config.ts ./
COPY frontend/index.html ./
COPY frontend/ui-kit-preview.html ./
COPY frontend/public ./public
COPY frontend/packages ./packages
COPY frontend/src ./src
RUN npm ci && npm run build

# Final stage
FROM python:3.11-slim

WORKDIR /app

# Apply the current Debian security updates to the runtime base layer and
# refresh the bundled Python packaging tools before copying application deps.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && python -m pip install --no-cache-dir --upgrade pip==26.2.2 setuptools==84.1.0 wheel==0.46.3 \
    && rm -rf /var/lib/apt/lists/*

# Copy Python dependencies from builder
COPY --from=builder /root/.local /root/.local

# Copy built frontend
COPY --from=frontend-builder /app/frontend/dist frontend/dist

# Copy application source
COPY src src/
COPY tools/document-toolkit tools/document-toolkit/
COPY tools/filesystem-toolkit tools/filesystem-toolkit/
COPY docs/governed-execution/GEX_V1_SCHEMA.json docs/governed-execution/GEX_V1_SCHEMA.json
COPY docs/public-web/MANUAL.md docs/public-web/MANUAL.md
COPY docs/agent-write/MANUAL_ES.md docs/agent-write/MANUAL_ES.md
COPY runtime/ber runtime/ber/
COPY scripts/ber_effect_demo.py scripts/ber_effect_demo.py

# Set PATH for pip-installed binaries
ENV PATH=/root/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/api/health').read()" || exit 1

CMD ["python", "-m", "src.api.server"]
