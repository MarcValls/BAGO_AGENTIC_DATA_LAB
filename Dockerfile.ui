FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies
COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt fastapi uvicorn

# Build frontend
FROM node:22-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
COPY frontend/tsconfig*.json ./
COPY frontend/vite.config.ts ./
COPY frontend/index.html ./
COPY frontend/ui-kit-preview.html ./
COPY frontend/public ./public
COPY frontend/packages ./packages
COPY frontend/src ./src
RUN npm ci && npm run build

# Final stage
FROM python:3.11-slim

WORKDIR /app

# Copy Python dependencies from builder
COPY --from=builder /root/.local /root/.local

# Copy built frontend
COPY --from=frontend-builder /app/frontend/dist frontend/dist

# Copy application source
COPY src src/
COPY runtime/ber runtime/ber/
COPY scripts/ber_effect_demo.py scripts/ber_effect_demo.py

# Set PATH for pip-installed binaries
ENV PATH=/root/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/api/health').read()" || exit 1

CMD ["python", "-m", "src.api.server"]
