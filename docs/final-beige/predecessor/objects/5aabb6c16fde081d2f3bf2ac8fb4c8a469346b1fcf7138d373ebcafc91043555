  .workspace-sidebar .workspace-sidebar-footer .settings-trigger { flex: 0 0 auto; white-space: nowrap; }
  .workspace-sidebar .primary-navigation { grid-column: 1 / -1; grid-row: 2; overflow-x: auto; overflow-y: hidden; flex-direction: row; align-items: stretch; scrollbar-width: thin; }
  .workspace-sidebar .navigation-group { width: max-content; min-width: max-content; flex: 0 0 auto; flex-wrap: nowrap; align-items: center; }
