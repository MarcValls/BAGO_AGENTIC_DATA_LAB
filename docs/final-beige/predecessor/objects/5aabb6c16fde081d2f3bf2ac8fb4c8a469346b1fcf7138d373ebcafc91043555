/* Application work areas fill their viewport; headers retain intrinsic height. */
.app-view:not(.app-view--chat) { display: flex; flex-direction: column; align-items: stretch; container-type: inline-size; container-name: app-view; }
.app-view > :is(.communications, .contacts-page, .workspace-manager, .agent-management, .agent-builder, .agent-tasks, .evaluation-lab, .capability-manager, .agent-runner) { flex: 1 0 auto; width: 100%; min-width: 0; min-height: 0; }
.app-view > .agent-tasks-advanced { flex: 0 0 auto; }
.data-layer[open], .settings-layer[open] { display: grid; grid-template-rows: auto minmax(0, 1fr); }
.data-layer-layout, .settings-layer-layout { min-height: 0; height: auto; }
.data-layer-content, .settings-layer-content { display: flex; flex-direction: column; align-items: stretch; container-type: inline-size; container-name: work-area; }
.data-layer-content > *, .settings-layer-content > * { min-width: 0; flex: 1 0 auto; }
.data-layer-header, .settings-layer-header { flex-wrap: wrap; }
@container app-view (max-width: 720px) {
  .agent-tasks-layout, .eval-layout, .eval-layout.suites-collapsed { grid-template-columns: minmax(0, 1fr); }
}
@container work-area (max-width: 720px) {
  .jobs-grid, .evidence-explorer__layout, .openai-provider-settings { grid-template-columns: minmax(0, 1fr); }
