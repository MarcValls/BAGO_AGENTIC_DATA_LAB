/* Language is a presentation preference; changing it does not remount views. */
.language-selector { display: flex; min-width: 0; flex-direction: column; gap: 5px; }
.language-selector label { display: flex; min-width: 0; align-items: center; flex-wrap: wrap; gap: 8px; font-size: .8rem; }
.language-selector select { max-width: 100%; min-width: 0; padding: 6px 9px; border: 1px solid #55758e; border-radius: 4px; background: #102030; color: #edf5fc; font: inherit; }
.language-selector small { max-inline-size: 50ch; color: #dfc28a; }
.language-selector--compact { margin-inline-start: auto; }
.language-selector select:focus-visible { outline: 2px solid #8bd5ff; outline-offset: 2px; }
/* IH01: source is a dataset choice, represented by native pressed buttons. */
.data-layer-heading { min-width: 0; flex: 1 1 0; }
.inspection-source-switch { display: flex; flex-wrap: wrap; gap: 4px; width: fit-content; max-width: 100%; margin: 6px 0; padding: 4px; border: 1px solid #3c5870; border-radius: 6px; background: #0e1d2c; }
.inspection-source-switch > button { min-width: 0; min-height: 38px; padding: 8px 12px; border: 1px solid transparent; border-radius: 4px; background: transparent; color: #b8cfdf; font: inherit; font-size: .8rem; text-align: left; overflow-wrap: anywhere; }
.inspection-source-switch > button[aria-pressed='true'] { border-color: #7bbbd6; background: #24485f; color: #f2f8fc; box-shadow: inset 0 -2px #9ed9ef; }
.inspection-source-switch > button:hover { background: #2b465c; color: #fff; }
.inspection-source-switch > button:focus-visible { outline: 3px solid #8bd5ff; outline-offset: 2px; }
/* EX01: navigation items scroll independently; the inspector exit remains at its foot. */
.data-layer-navigation { flex-direction: column; overflow: hidden; padding: 0; gap: 0; }
.data-layer-navigation-items { display: flex; min-width: 0; min-height: 0; flex: 1 1 0; flex-direction: column; gap: 3px; overflow: auto; padding: 12px 9px; }
.data-layer-navigation-footer { flex: 0 0 auto; margin-top: auto; padding: 10px 9px; border-top: 1px solid #344b65; background: #122337; }
.data-layer-navigation-footer .inspector-exit { width: 100%; min-width: 0; min-height: 40px; border-color: #496a87; background: #1b344c; color: #e4f0fb; text-align: left; }
.data-layer-navigation-footer .inspector-exit:hover { border-color: #91c5e1; background: #284a65; }
.data-layer-navigation-footer .inspector-exit:focus-visible { outline: 3px solid #8bd5ff; outline-offset: 2px; }
@media (max-width: 760px) {
  .data-layer-navigation { flex-direction: column; overflow: hidden; padding: 0; }
  .data-layer-navigation-items { flex: 0 1 auto; flex-direction: row; overflow-x: auto; overflow-y: hidden; padding: 5px 7px; }
  .data-layer-navigation-footer { margin-top: 0; padding: 6px 7px; }
}

/* COLOR_INSPECTOR: decoration only; inspector geometry is preserved. */
.data-layer :is(.data-layer-header, .data-layer-navigation, .navigation-item),
.data-layer .inspection-source-switch,
.data-layer .inspection-source-switch > button { border-radius: 0; }
.data-layer .data-layer-header { border-bottom-color: #44899d; background: linear-gradient(105deg, #173f56, #192d49 55%, #123c40); box-shadow: inset 0 1px #69ccdc; }
.data-layer .data-layer-heading h2 { color: #e2f7ff; }
.data-layer .data-layer-navigation { background: linear-gradient(180deg, #102b3b, #101e30 65%, #112d34); border-right-color: #396276; }
.data-layer .data-layer-navigation .navigation-item.active { color: #e4fbff; border-color: #499baa; background: linear-gradient(100deg, #205063, #1a3851); box-shadow: inset 3px 0 #6ad8ca; }
.data-layer .inspection-source-switch { border-color: #407b90; background: #0e2333; }
.data-layer .inspection-source-switch > button[aria-pressed='true'] { border-color: #65c1d0; background: linear-gradient(110deg, #22566b, #21405e); color: #f0fcff; box-shadow: inset 0 -2px #80e0d2; }
.data-layer .inspection-source-switch > button:hover { background: linear-gradient(110deg, #286079, #26455f); }
.data-layer .data-layer-navigation-footer { border-top-color: #3c8090; background: linear-gradient(100deg, #143b46, #142c42); }
.data-layer .data-layer-navigation-footer .inspector-exit { border-radius: 0; color: #dcfbf8; border-color: #4a9eaa; background: linear-gradient(105deg, #1e4e5c, #1d3853); box-shadow: inset 0 -1px #6bcac8; }
.data-layer .data-layer-navigation-footer .inspector-exit:hover { background: linear-gradient(105deg, #286475, #264d6a); border-color: #8de0dc; }
.data-layer :is(.inspector-exit, .inspection-source-switch > button):focus-visible { outline-color: #a0edf2; }
