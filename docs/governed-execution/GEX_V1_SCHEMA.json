{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcValls/BAGO_AGENTIC_DATA_LAB/blob/main/docs/governed-execution/GEX_V1_SCHEMA.json",
  "title": "GEX v1 contract wire schemas — PREPARED / NOT_DEPLOYED",
  "description": "Structural validation only. JCS digest, signature, time order, policy, reference consistency, CAS and ledger state transitions require semantic implementation and conformance tests.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/GEXRequestV1"
    },
    {
      "$ref": "#/$defs/PolicyDecisionV1"
    },
    {
      "$ref": "#/$defs/ApprovalV1"
    },
    {
      "$ref": "#/$defs/PermitV1"
    },
    {
      "$ref": "#/$defs/CapabilityRegistrationV1"
    },
    {
      "$ref": "#/$defs/ReceiptV1"
    },
    {
      "$ref": "#/$defs/LedgerEventV1"
    },
    {
      "$ref": "#/$defs/ToolProposalEnvelopeV1"
    },
    {
      "$ref": "#/$defs/ProposalDenialReceiptV1"
    },
    {
      "$ref": "#/$defs/PermitUseStateV1"
    }
  ],
  "$defs": {
    "Principal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "session_binding": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "auth_strength": {
          "const": "verified"
        }
      },
      "required": [
        "issuer",
        "subject",
        "session_binding",
        "auth_strength"
      ]
    },
    "Agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "config_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "agent_id",
        "config_digest",
        "revision"
      ]
    },
    "Workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "binding_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "repository_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "context_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "root_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "workspace_id",
        "binding_fingerprint",
        "repository_identity",
        "branch",
        "commit_sha",
        "context_revision",
        "root_identity"
      ]
    },
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "registry_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "executor_kind": {
          "enum": [
            "local",
            "mcp"
          ]
        },
        "effect": {
          "enum": [
            "READ",
            "WRITE",
            "CREATE",
            "DELETE",
            "EXTERNAL_API",
            "EXTERNAL_TOOL"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "registry_digest",
        "schema_digest",
        "executor_kind",
        "effect"
      ]
    },
    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "type": "object"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "effect_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "arguments",
        "target",
        "effect_scope"
      ]
    },
    "Constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sandbox_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "network": {
          "enum": [
            "deny",
            "allowlist"
          ]
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "write_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "egress_allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true
        }
      },
      "required": [
        "sandbox_profile",
        "network",
        "timeout_ms",
        "max_output_bytes",
        "write_scope",
        "egress_allowlist"
      ]
    },
    "PolicyRevision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "revision",
        "policy_digest"
      ]
    },
    "GEXRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "gex-request/v1"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "proposal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "agent": {
          "$ref": "#/$defs/Agent"
        },
        "workspace": {
          "$ref": "#/$defs/Workspace"
        },
        "capability": {
          "$ref": "#/$defs/Capability"
        },
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "constraints": {
          "$ref": "#/$defs/Constraints"
        },
        "policy": {
          "$ref": "#/$defs/PolicyRevision"
        },
        "context_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "proposed_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "contract_version",
        "request_id",
        "run_id",
        "proposal_id",
        "principal",
        "agent",
        "workspace",
        "capability",
        "operation",
        "constraints",
        "policy",
        "context_revision",
        "proposed_at",
        "expires_at",
        "nonce"
      ]
    },
    "PolicyDecisionV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "gex-policy-decision/v1"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "result": {
          "enum": [
            "ALLOW",
            "DENY",
            "REQUIRE_HUMAN"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "constraints_effective": {
          "anyOf": [
            {
              "$ref": "#/$defs/Constraints"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "contract_version",
        "decision_id",
        "request_id",
        "request_digest",
        "policy_revision",
        "actor",
        "result",
        "reason_code",
        "constraints_effective",
        "timestamp"
      ]
    },
    "ApprovalV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "gex-approval/v1"
        },
        "approval_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "principal_subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "workspace_binding_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "operation_summary_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision": {
          "enum": [
            "APPROVED",
            "REJECTED"
          ]
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "auth_context_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "signature_algorithm": {
          "enum": [
            "HMAC-SHA256",
            "Ed25519"
          ]
        }
      },
      "required": [
        "contract_version",
        "approval_id",
        "request_digest",
        "actor",
        "principal_subject",
        "workspace_binding_fingerprint",
        "operation_summary_digest",
        "decision",
        "issued_at",
        "expires_at",
        "auth_context_ref",
        "evidence_ref",
        "key_id",
        "signature",
        "signature_algorithm"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "signature_algorithm": {
                "const": "HMAC-SHA256"
              }
            },
            "required": [
              "signature_algorithm"
            ]
          },
          "then": {
            "properties": {
              "signature": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "signature_algorithm": {
                "const": "Ed25519"
              }
            },
            "required": [
              "signature_algorithm"
            ]
          },
          "then": {
            "properties": {
              "signature": {
                "pattern": "^[A-Za-z0-9_-]{86}$"
              }
            }
          }
        }
      ]
    },
