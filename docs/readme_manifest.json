{
  "project": {
    "title": "BAGO Agentic Data Lab",
    "emoji": "🧪",
    "description": "Laboratorio experimental para desarrollar capacidades de AI Engineering con gobernanza BAGO.",
    "repository": "https://github.com/MarcValls/BAGO_AGENTIC_DATA_LAB",
    "default_branch": "main",
    "license": "MIT"
  },
  "architecture": {
    "principle": "LangGraph propone → BAGO autoriza → ExecutionGateway ejecuta → Receipt evidencia.",
    "pipeline": [
      "RAG recupera documentos y citas",
      "Ontology Engine materializa RDF/Turtle",
      "SPARQL local consulta relaciones",
      "Inference añade inversas, transitivas y simétricas",
      "Constraints detecta endpoints, evidencia y contradicciones",
      "El LLM recibe caminos y evidencia; no recibe autoridad implícita"
    ]
  },
  "phases": [
