"""Read-only receipt/byte verification; never re-executes tests or a model."""
from pathlib import Path
import hashlib,json,re,subprocess,sys,xml.etree.ElementTree as ET
HERE=Path(__file__).resolve().parent;REPO=next(p for p in HERE.parents if (p/'.git').exists())
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
load=lambda p:json.loads(p.read_text(encoding='utf-8-sig'))
manifest=load(HERE/'INPUT_MANIFEST.json');docker=load(HERE/'attempt1/RESULT.json');inner=load(HERE/'attempt1/inner-result.json');local=load(HERE/'local-check-attempt1/RESULT.json')
assert docker['status']==inner['status']==local['status']=='PASS'
assert docker['returncode']==local['returncode']==0 and docker['writeback'] and docker['container_removed']
assert all(sha(REPO/v['path'])==v['sha256'] for v in manifest['uncommitted_overlay'])
assert subprocess.check_output(['git','rev-parse','HEAD'],cwd=REPO,text=True).strip()==manifest['head']
generation=next(s for s in inner['steps'] if s['label']=='generate')
assert generation['returncode']==0 and generation['argv'][-1]=='scripts/generate_dynamic_readme.py' and '--skip-tests' not in generation['argv']
assert next(s for s in inner['steps'] if s['label']=='consistency')['returncode']==0
assert '--check' in local['argv'] and '--skip-tests' in local['argv']
match=re.search(r'README generado tras (\d+) tests pasados',(HERE/'attempt1/generate.stdout.log').read_text())
assert match and int(match[1])==generation['pytest_passed']
tree=ET.parse(HERE/'attempt1/generate.xml');suites=list(tree.getroot().iter('testsuite'))
counts={k:sum(int(s.get(k,0)) for s in suites) for k in ['tests','failures','errors','skipped']}
assert counts['failures']==counts['errors']==0
for record in docker['generated_files']:
    assert sha(REPO/record['path'])==record['sha256']==next(v['sha256'] for v in local['readmes'] if v['path']==record['path'])
    assert sha(HERE/'attempt1'/(record['path']+'.generated'))==record['sha256']
for step in inner['steps']:
    for file in step['files']:assert sha(HERE/'attempt1'/file['path'])==file['sha256']
print(json.dumps({'status':'PASS','scope':'Read-only verification of preserved actual generator/full-suite and final worktree consistency receipts.',
 'head_unchanged':manifest['head'],'product_source_files':len(manifest['uncommitted_overlay']),
 'pytest_passed':generation['pytest_passed'],'junit_counts_including_subtests':counts,'readmes':docker['generated_files'],
 'environment_limit':'Docker pypdf6.21.2 vs declared pin6.21.4; exact pinned CI not claimed.',
 'docs_scope':'New public docs were added after Docker input capture; final actual-worktree consistency included them. No claim that Docker suite executed their separate export verifier.'}))
