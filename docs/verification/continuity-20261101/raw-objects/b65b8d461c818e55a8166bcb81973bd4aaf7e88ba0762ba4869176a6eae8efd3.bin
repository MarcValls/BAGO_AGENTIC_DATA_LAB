{"type": "item.started", "item": {"id": "item_6", "type": "command_execution", "command": "\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -NoProfile -Command \"@'\nfrom pathlib import Path\nimport hashlib,json\np=Path.cwd()\nassert not (p/'STOP.md').exists(), 'STOP_PRESENT'\nassert not (p/'phase-B.json').exists(), 'Phase B receipt already exists'\nassert not (p/'probe-B.json').exists(), 'Phase B probe already exists; do not repeat'\nc=json.loads((p/'CONTRACT.json').read_text(encoding='utf-8'))\nh=json.loads((p/'accepted-handoff.json').read_text(encoding='utf-8'))\na=json.loads((p/'phase-A.json').read_text(encoding='utf-8'))\nassert p.resolve()==Path(c['worker_scope']).resolve()\nassert h['status']=='PASS' and h['worker']=='native-B'\nassert h['checkpoint']['candidate']['id']=='bounded-native-host-r1'\nfor item in h['checkpoint']['artifacts']:\n    assert item['root']=='workspace'\n    f=p/item['path']\n    assert f.resolve().parent==p.resolve()\n    raw=f.read_bytes()\n    assert hashlib.sha256(raw).hexdigest()==item['sha256'], item['path']+' hash mismatch'\n    assert len(raw)==item['size'], item['path']+' size mismatch'\nassert a['phase']=='A' and a['answer']==c['A']['expected_answer']\nprint(json.dumps({'predecessor_sha256':hashlib.sha256((p/'phase-A.json').read_bytes()).hexdigest(),'accepted_handoff_sha256':hashlib.sha256((p/'accepted-handoff.json').read_bytes()).hexdigest(),'answer':a['answer']+1,'checkpoint_artifacts_verified':True}))\n'@ | python -B -\nif (\"'$LASTEXITCODE -ne 0) { exit $LASTEXITCODE }\nif (Test-Path -LiteralPath '\"'STOP.md') { Write-Output 'STOP_PRESENT'; exit 20 }\npython -B boundary_probe.py B\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
