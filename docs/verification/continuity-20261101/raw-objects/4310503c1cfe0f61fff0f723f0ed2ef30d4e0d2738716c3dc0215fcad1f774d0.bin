"""Read-only gate verification for this historical fixed publication candidate."""
from pathlib import Path
import hashlib,json,re,subprocess,xml.etree.ElementTree as ET
HERE=Path(__file__).resolve().parent;REPO=next(p for p in HERE.parents if (p/'.git').exists())
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
load=lambda p:json.loads(p.read_text(encoding='utf-8-sig'))
manifest=load(HERE/'INPUT_MANIFEST.json');docker=load(HERE/'attempt1/RESULT.json');inner=load(HERE/'attempt1/inner-result.json');local=load(HERE/'local-check-attempt1/RESULT.json')
assert docker['status']==inner['status']==local['status']=='PASS'
assert docker['returncode']==local['returncode']==0 and docker['writeback'] and docker['container_removed']
assert all(sha(REPO/v['path'])==v['sha256'] for v in manifest['uncommitted_overlay'])
assert subprocess.check_output(['git','rev-parse','HEAD'],cwd=REPO,text=True).strip()==manifest['head']
generated=next(s for s in inner['steps'] if s['label']=='generate')
assert generated['returncode']==0 and generated['argv'][-1]=='scripts/generate_dynamic_readme.py' and '--skip-tests' not in generated['argv']
assert next(s for s in inner['steps'] if s['label']=='consistency')['returncode']==0
assert '--check' in local['argv'] and '--skip-tests' in local['argv']
match=re.search(r'README generado tras (\d+) tests pasados',(HERE/'attempt1/generate.stdout.log').read_text())
assert match and int(match[1])==generated['pytest_passed']
suites=list(ET.parse(HERE/'attempt1/generate.xml').getroot().iter('testsuite'))
counts={k:sum(int(s.get(k,0)) for s in suites) for k in ['tests','failures','errors','skipped']}
assert counts['failures']==counts['errors']==0
for file in docker['generated_files']:
    assert sha(REPO/file['path'])==file['sha256']==local['readmes_unchanged_by_check'][file['path']]
    assert sha(HERE/'attempt1'/(file['path']+'.generated'))==file['sha256']
for step in inner['steps']:
    for file in step['files']:assert sha(HERE/'attempt1'/file['path'])==file['sha256']
print(json.dumps({'status':'PASS','scope':'Read-only stored generator/full-suite and final Windows worktree consistency validation; no tests/models rerun.',
 'head_unchanged':manifest['head'],'overlay':manifest['uncommitted_overlay'],'pytest_passed':generated['pytest_passed'],
 'junit_counts_including_subtests':counts,'readmes':docker['generated_files'],
 'limits':['pypdf6.21.2 image vs6.21.4 pin; exact pinned CI separate.','Root public export added/updated after Docker input capture; final Windows consistency covers current render, not its separate export verifier.','No product changes or UI branch claim; this gate belongs to original continuity publication only.']}))
