{"baseline":"P2R revision2 handoff","contract":"exact origin plus zero or one --parent-window=[+-]?[0-9]+ with no spaces; decimal value must fit signed struct.calcsize(\"P\")*8 range","files":[{"baseline_sha256":"abdc0826f325eea6d643dc84b33a9a8c8d2afa7b02662483a1ec84f67f559253","insertions":["PARENT_WINDOW_RE = re.compile(r\"--parent-window=([+-]?[0-9]+)\\Z\")","def _sender_origin_from_argv(argv: list[str]) -> str:\n    \"\"\"Validate the exact Chromium Native Messaging invocation arguments.\n\n    ``argv`` includes the executable at index zero. Chromium supplies the\n    extension origin at index one and may append one signed decimal parent\n    window handle. The optional value is validated for pointer-width range;\n    it is not used as authority for any host operation.\n    \"\"\"\n    if len(argv) not in (2, 3) or argv[1] != EXTENSION_ORIGIN:\n        raise ProtocolError(\"invalid native host arguments\")\n    if len(argv) == 3:\n        match = PARENT_WINDOW_RE.fullmatch(argv[2])\n        if match is None:\n            raise ProtocolError(\"invalid native host arguments\")\n        try:\n            parent_window = int(match.group(1), 10)\n        except ValueError as exc:\n            raise ProtocolError(\"invalid native host arguments\") from exc\n        pointer_bits = struct.calcsize(\"P\") * 8\n        minimum = -(1 << (pointer_bits - 1))\n        maximum = (1 << (pointer_bits - 1)) - 1\n        if not minimum <= parent_window <= maximum:\n            raise ProtocolError(\"invalid native host arguments\")\n    return argv[1]\n\n"],"path":"src/browser_bridge/native_host.py","replacement":{"after":"if sender_origin is None:\n    try:\n        sender_origin = _sender_origin_from_argv(sys.argv)\n    except ProtocolError:\n        LOGGER.error(\"native host rejected invocation arguments\")\n        return 3","before":"sender_origin = sender_origin if sender_origin is not None else (sys.argv[1] if len(sys.argv) == 2 else \"\")"},"result_sha256":"d1b41137e6497c301b3fdfafa0608365d2a5103a5585a3dced16e53fe0e950cf"},{"appended_tests":"@pytest.mark.parametrize(\n    \"parent_argument\",\n    [\n        None,\n        \"--parent-window=0\",\n        \"--parent-window=+1\",\n        \"--parent-window=-1\",\n        \"--parent-window=+0\",\n        \"--parent-window=-0\",\n        \"--parent-window={minimum}\",\n        \"--parent-window={maximum}\",\n    ],\n)\ndef test_invocation_accepts_exact_origin_with_optional_signed_pointer_value(parent_argument: str | None) -> None:\n    pointer_bits = struct.calcsize(\"P\") * 8\n    minimum = -(1 << (pointer_bits - 1))\n    maximum = (1 << (pointer_bits - 1)) - 1\n    if parent_argument is not None:\n        parent_argument = parent_argument.format(minimum=minimum, maximum=maximum)\n    argv = [\"BagoBrowserBridgeHost.exe\", host.EXTENSION_ORIGIN]\n    if parent_argument is not None:\n        argv.append(parent_argument)\n    assert host._sender_origin_from_argv(argv) == host.EXTENSION_ORIGIN\n\n\n@pytest.mark.parametrize(\n    \"argv\",\n    [\n        [\"BagoBrowserBridgeHost.exe\"],\n        [\"BagoBrowserBridgeHost.exe\", \"chrome-extension://wrong/\"],\n        [\"BagoBrowserBridgeHost.exe\", host.EXTENSION_ORIGIN, \"--parent-window\"],\n        [\"BagoBrowserBridgeHost.exe\", host.EXTENSION_ORIGIN, \"--parent-window=\"],\n        [\"BagoBrowserBridgeHost.exe\", host.EXTENSION_ORIGIN, \"--parent-window=+\"],\n        [\"BagoBrowserBridgeHost.exe\", host.EXTENSION_ORIGIN, \"--parent-window= 1\"],\n        [\"BagoBrowserBridgeHost.exe\", host.EXTENSION_ORIGIN, \"--parent-window=1 \"],\n        [\"BagoBrowserBridgeHost.exe\", host.EXTENSION_ORIGIN, \"--parent-window=1.0\"],\n        [\"BagoBrowserBridgeHost.exe\", host.EXTENSION_ORIGIN, \"--parent-window=0x10\"],\n        [\"BagoBrowserBridgeHost.exe\", host.EXTENSION_ORIGIN, \"--parent-window=١\"],\n        [\"BagoBrowserBridgeHost.exe\", host.EXTENSION_ORIGIN, \"--parent-window=0\", \"--parent-window=1\"],\n        [\"BagoBrowserBridgeHost.exe\", host.EXTENSION_ORIGIN, \"--unknown=1\"],\n    ],\n)\ndef test_invocation_rejects_missing_wrong_malformed_duplicate_or_unknown_arguments(argv: list[str]) -> None:\n    with pytest.raises(host.ProtocolError, match=\"arguments\"):\n        host._sender_origin_from_argv(argv)\n\n\n@pytest.mark.parametrize(\"outside\", [\"minimum\", \"maximum\"])\ndef test_invocation_rejects_signed_pointer_width_overflow(outside: str) -> None:\n    pointer_bits = struct.calcsize(\"P\") * 8\n    value = -(1 << (pointer_bits - 1)) - 1 if outside == \"minimum\" else 1 << (pointer_bits - 1)\n    with pytest.raises(host.ProtocolError, match=\"arguments\"):\n        host._sender_origin_from_argv(\n            [\"BagoBrowserBridgeHost.exe\", host.EXTENSION_ORIGIN, f\"--parent-window={value}\"]\n        )\n\n\ndef test_invocation_rejects_decimal_value_that_cannot_be_converted() -> None:\n    with pytest.raises(host.ProtocolError, match=\"arguments\"):\n        host._sender_origin_from_argv(\n            [\"BagoBrowserBridgeHost.exe\", host.EXTENSION_ORIGIN, \"--parent-window=\" + (\"9\" * 5000)]\n        )\n\n\ndef test_run_rejects_invalid_argv_before_reading_frames_or_writing_stdout(monkeypatch: pytest.MonkeyPatch) -> None:\n    hello = {\"protocol_version\": host.PROTOCOL_VERSION, \"type\": \"hello\", \"request_id\": \"argv_test\"}\n    monkeypatch.setattr(\n        host.sys,\n        \"argv\",\n        [\"BagoBrowserBridgeHost.exe\", host.EXTENSION_ORIGIN, \"--parent-window=0\", \"--parent-window=1\"],\n    )\n    output_stream = io.BytesIO()\n    result = host.run(io.BytesIO(host.encode_frame(hello)), output_stream)\n    assert result == 3\n    assert output_stream.getvalue() == b\"\"\n\n\n@pytest.mark.parametrize(\"parent_argument\", [None, \"--parent-window=-7\"])\ndef test_run_accepts_chromium_argv_and_processes_hello(monkeypatch: pytest.MonkeyPatch, parent_argument: str | None) -> None:\n    hello = {\"protocol_version\": host.PROTOCOL_VERSION, \"type\": \"hello\", \"request_id\": \"argv_hello\"}\n    argv = [\"BagoBrowserBridgeHost.exe\", host.EXTENSION_ORIGIN]\n    if parent_argument is not None:\n        argv.append(parent_argument)\n    monkeypatch.setattr(host.sys, \"argv\", argv)\n    output_stream = io.BytesIO()\n    result = host.run(io.BytesIO(host.encode_frame(hello)), output_stream)\n    assert result == 0\n    output_stream.seek(0)\n    response = host.read_frame(output_stream)\n    assert response and response[\"type\"] == \"ready\"\n","baseline_sha256":"d24eb69ed9b77f17d528a888a3257897fbc65b023dd2d9cd7136f52059dec5a4","path":"tests/browser_bridge/host/test_native_host.py","result_sha256":"a7b8792aeab2c1b174d5f08e0b0d9b627d006a7d4662d7656283e7820c5214f2"}],"schema_version":"bago.browser-bridge.p2-host-source-diff.v1"}
