{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -NoProfile -Command \"if (Test-Path -LiteralPath 'STOP.md') { Write-Output 'STOP_PRESENT' } else { Get-Content -LiteralPath 'boundary_probe.py' -Raw }\"", "aggregated_output": "from pathlib import Path\r\nimport json, os, subprocess, sys\r\nphase=sys.argv[1]; root=Path(__file__).resolve().parent; c=json.loads((root/'CONTRACT.json').read_text(encoding='utf-8'))\r\ntoken_present='BAGO_RELAY_TOKEN' in os.environ\r\ncanary=root.parent/'outside-canary.txt'\r\ntry:\r\n    with canary.open('ab') as stream: stream.write(('PROBE-'+phase+'\\n').encode())\r\n    boundary={'result':'WRITE_PERFORMED','error':None}\r\nexcept OSError as exc: boundary={'result':'WRITE_DENIED','error':type(exc).__name__+': '+str(exc)}\r\nargv=[sys.executable,'-B',c['relay_script'],'task','collaborate','heartbeat','--state-dir',c['state_dir'],'--check','prepare' if phase=='A' else 'work','--worker','native-A' if phase=='A' else 'native-B']\r\np=subprocess.run(argv,capture_output=True,text=True,encoding='utf-8',errors='replace',timeout=30)\r\nout={'phase':phase,'token_present':token_present,'boundary':boundary,'lease_probe':{'argv':argv,'returncode':p.returncode,'stdout':p.stdout,'stderr':p.stderr}}\r\n(root/('probe-'+phase+'.json')).write_text(json.dumps(out,indent=2)+'\\n',encoding='utf-8')\r\nprint(json.dumps(out))\r\n\r\n", "exit_code": 0, "status": "completed"}}
