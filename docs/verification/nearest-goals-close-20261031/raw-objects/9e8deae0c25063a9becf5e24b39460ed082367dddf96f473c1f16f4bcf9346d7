import assert from 'node:assert/strict'
import { createServer } from 'node:http'
import { readFile, writeFile, mkdir } from 'node:fs/promises'
import { dirname, extname, join, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'
import { createHash } from 'node:crypto'
import { chromium } from '../../../nearest-goals-check/node_modules/playwright-core/index.mjs'

const frontend = resolve(dirname(fileURLToPath(import.meta.url)), '../../..')
const attempt = process.argv[2] ?? 'browser-attempt1'
assert(/^browser-attempt[1-9]\d*$/.test(attempt))
const output = join(frontend, 'nearest-goals-check/footer-repair', attempt)
await mkdir(output, { recursive: false })
await mkdir(join(output, 'tmp'))
process.env.TEMP = join(output, 'tmp')
process.env.TMP = join(output, 'tmp')
const brave = 'C:/Program Files/BraveSoftware/Brave-Browser/Application/brave.exe'
const dist = join(frontend, 'dist')
const mime = { '.js': 'text/javascript', '.css': 'text/css', '.svg': 'image/svg+xml', '.png': 'image/png', '.html': 'text/html' }
const server = createServer(async (req, res) => {
  try {
    const rel = decodeURIComponent(new URL(req.url, 'http://localhost').pathname)
    const file = resolve(dist, '.' + (rel === '/' ? '/index.html' : rel))
    assert(file.startsWith(dist + '/') || file.startsWith(dist + '\\'))
    const bytes = await readFile(file)
    res.writeHead(200, { 'Content-Type': mime[extname(file)] || 'application/octet-stream' })
    res.end(bytes)
  } catch { res.writeHead(404); res.end('fixture asset unavailable') }
})
await new Promise(resolve => server.listen(0, '127.0.0.1', resolve))
const origin = `http://127.0.0.1:${server.address().port}`
const context = await chromium.launchPersistentContext(join(output, 'profile'), {
  executablePath: brave, headless: true, viewport: { width: 1280, height: 900 },
  serviceWorkers: 'block', args: ['--disable-extensions'],
})
const requests = [], unknown = [], external = [], pageErrors = [], checks = [], cases = []
const catalog = Array.from({ length: 18 }, (_, index) => ({ provider_id: 'ollama-cloud', model_id: `footer-${index + 1}`,
  display_name: `Modelo sintético ${index + 1}`, label: 'Proveedor sintético', state: 'ready' }))
const policy = { models: [], main_chat: null, revision: 'synthetic-footer-r1', catalog }
const fixture = path => {
  if (path === '/api/providers/model-policy') return policy
  if (path === '/api/providers/registry') return { registrations: [] }
  if (path === '/api/providers/ollama/status') return { state: 'not_configured' }
  if (path === '/api/providers/chat-models') return { models: [] }
  if (path === '/api/providers/selection') return { provider_id: null, model_id: null }
  if (path === '/api/agents/list') return { agents: [], warning_count: 0 }
  if (path === '/api/conversations') return { conversations: [] }
  if (path === '/api/project-folders/v1/active') return { project_id: 'synthetic-footer', title: 'Prueba de Salir', root: '/synthetic', scope: 'workspace' }
  if (path === '/api/chat/context') return { workspace_root: '/synthetic', paths: [], cognition: { profile: 'baseline', capacity: 1, max_hops: 1, max_expansions: 1 }, memory: { kind: 'synthetic', state: 'absent', description: 'Synthetic UI test only' } }
  return null
}
await context.addInitScript(() => localStorage.setItem('bago.ui.locale', 'es'))
await context.route('**/*', async route => {
  const request = route.request(), url = new URL(request.url())
  if (url.origin !== origin) { external.push(request.url()); return route.abort() }
  if (!url.pathname.startsWith('/api/')) return route.continue()
  requests.push({ method: request.method(), path: url.pathname })
  const data = fixture(url.pathname)
  if (request.method() !== 'GET' || data === null) {
    unknown.push({ method: request.method(), path: url.pathname })
    return route.fulfill({ status: 500, contentType: 'application/json', body: JSON.stringify({ detail: { message: 'No fixture for this request' } }) })
  }
  return route.fulfill({ contentType: 'application/json', body: JSON.stringify(data) })
})

function record(name, passed, evidence) { checks.push({ name, passed, evidence }) }
let fatal = null
try {
  for (const [name, viewport] of [['desktop', { width: 1280, height: 900 }], ['mobile', { width: 430, height: 932 }]]) {
    const page = await context.newPage()
