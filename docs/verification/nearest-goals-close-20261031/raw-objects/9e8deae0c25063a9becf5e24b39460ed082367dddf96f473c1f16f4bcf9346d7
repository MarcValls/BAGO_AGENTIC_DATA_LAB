    await page.goto(origin, { waitUntil: 'networkidle' })
    await page.getByRole('button', { name: 'Configuración', exact: true }).click()
    const dialog = page.locator('#settings-layer')
    await dialog.waitFor({ state: 'visible' })
    await dialog.getByRole('button', { name: 'Proveedores y modelos', exact: true }).click()
    await dialog.getByRole('tab', { name: 'Modelos activos', exact: true }).click()
    await dialog.getByRole('checkbox', { name: 'Orquestador · ollama-cloud|footer-1', exact: true }).waitFor()
    const exit = dialog.getByRole('button', { name: 'Salir', exact: true })
    await exit.waitFor({ state: 'attached' })
    await page.evaluate(() => new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve))))
    const geometry = await page.evaluate(() => {
      const footer = document.querySelector('.model-assignments-actions')
      const list = document.querySelector('.model-assignments-content')
      const section = document.querySelector('.model-assignments')
      const style = getComputedStyle(footer)
      const rect = el => { const r = el.getBoundingClientRect(); return { left: r.left, top: r.top, right: r.right, bottom: r.bottom, width: r.width, height: r.height } }
      return { footer: rect(footer), section: rect(section), buttons: [...footer.querySelectorAll('button')].map(rect),
        background: style.backgroundColor, border: [style.borderTopWidth, style.borderRightWidth, style.borderBottomWidth, style.borderLeftWidth],
        justify: style.justifyContent, list: { clientHeight: list.clientHeight, scrollHeight: list.scrollHeight, scrollTop: list.scrollTop },
        viewport: { width: innerWidth, height: innerHeight }, dialogOpen: document.querySelector('#settings-layer').open }
    })
    await page.screenshot({ path: join(output, `${name}-models-before-exit.png`) })
    record(`${name}:real App dialog open`, geometry.dialogOpen, geometry)
    record(`${name}:transparent borderless footer`, geometry.background === 'rgba(0, 0, 0, 0)' && geometry.border.every(x => x === '0px'), geometry)
    record(`${name}:footer aligned bottom right`, geometry.justify === 'flex-end' && Math.abs(geometry.footer.bottom - geometry.section.bottom) <= 1 && Math.abs(geometry.buttons.at(-1).right - geometry.footer.right) <= 1, geometry)
    record(`${name}:both footer buttons initially inside viewport`, geometry.buttons.every(b => b.top >= 0 && b.bottom <= viewport.height && b.left >= 0 && b.right <= viewport.width), geometry)
    const scroll = await page.locator('.model-assignments-content').evaluate(list => { const before = list.scrollTop; list.scrollTop = list.scrollHeight; return { before, after: list.scrollTop, height: list.clientHeight, total: list.scrollHeight } })
    const footerAfter = await page.locator('.model-assignments-actions').boundingBox()
    record(`${name}:list scrolls independently`, scroll.after > scroll.before && scroll.total > scroll.height && Math.abs(footerAfter.y - geometry.footer.top) <= 1, scroll)
    await page.screenshot({ path: join(output, `${name}-models-after-list-scroll.png`) })
    await dialog.getByRole('checkbox', { name: 'Orquestador · ollama-cloud|footer-1', exact: true }).check()
    const beforeExit = requests.length
    await exit.click()
    await page.waitForFunction(() => !document.querySelector('#settings-layer').open)
    record(`${name}:Exit closes actual Settings dialog`, !(await dialog.evaluate(node => node.open)), { beforeExit, afterExit: requests.length })
    record(`${name}:Exit has no implicit mutation`, requests.every(r => r.method === 'GET'), requests)
    await page.screenshot({ path: join(output, `${name}-after-exit.png`) })
    await writeFile(join(output, `${name}-after-exit.html`), await page.content())
    cases.push({ name, viewport, geometry, scroll })
    await page.close()
  }
} catch (error) {
  fatal = { message: String(error), stack: error.stack }
  for (const page of context.pages()) await page.screenshot({ path: join(output, 'failure.png') }).catch(() => {})
} finally {
  await context.close()
  await new Promise(resolve => server.close(resolve))
}
record('no external traffic', external.length === 0, external)
record('all API routes synthetic and expected', unknown.length === 0, unknown)
record('no App page errors', pageErrors.length === 0, pageErrors)
const result = { status: !fatal && checks.every(c => c.passed) ? 'PASS' : 'FAIL', scope: 'actual built App, headless Brave, synthetic intercepted localhost API only',
  headless: true, user_focus_changed: false, actualApp: true, provider_calls: 'NOT_RUN', production_servers_used: false,
  brave_executable: brave, origin, catalog_models: catalog.length, cases, checks, requests, unknown, external, pageErrors, fatal }
