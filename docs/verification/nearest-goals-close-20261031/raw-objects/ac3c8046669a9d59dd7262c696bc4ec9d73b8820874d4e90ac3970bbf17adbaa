describe('Model footer Exit', () => {
  const model = { provider_id: 'ollama-cloud', model_id: 'footer-fixture', label: 'Synthetic provider', state: 'ready' }
  const policy = { models: [], main_chat: null, revision: 'footer-r1', catalog: [model] }

  function footerApi(state: string, mutations: string[]) {
    vi.stubGlobal('fetch', vi.fn(async (input: string, init?: RequestInit) => {
      const url = String(input)
      if (init?.method && init.method !== 'GET') mutations.push(url)
      if (url === '/api/providers/registry') return response({ registrations: [] })
      if (url === '/api/providers/ollama/status') return response({ state: 'not_configured' })
      if (url === '/api/providers/model-policy') {
        if (state === 'error') return response({ detail: { message: 'Synthetic model inventory failure.' } }, 503)
        return response({ ...policy, catalog: state === 'empty' ? [] : [{ ...model, state: state === 'unavailable' ? 'unavailable' : 'ready' }] })
      }
      throw new Error(`Unexpected request: ${url}`)
    }))
  }

  it.each(['normal', 'empty', 'unavailable', 'error'])('calls the parent Exit without saving (%s)', async state => {
    const mutations: string[] = []
    const onExit = vi.fn()
    footerApi(state, mutations)
    render(<ProviderSettings onExit={onExit} />)
    fireEvent.click(screen.getByRole('tab', { name: 'Modelos activos' }))
    const exit = screen.getByRole('button', { name: 'Salir', exact: true }) as HTMLButtonElement
    await waitFor(() => expect(exit.disabled).toBe(false))
    if (state === 'normal') fireEvent.click(screen.getByLabelText('Orquestador · ollama-cloud|footer-fixture'))
    if (state === 'error') expect(screen.getByRole('alert').textContent).toContain('Synthetic model inventory failure.')
    fireEvent.click(exit)
    expect(onExit).toHaveBeenCalledTimes(1)
    expect(mutations).toEqual([])
  })

  it('preserves standalone navigation back to Providers without saving', async () => {
    const mutations: string[] = []
    footerApi('empty', mutations)
    render(<ProviderSettings />)
    fireEvent.click(screen.getByRole('tab', { name: 'Modelos activos' }))
    const exit = screen.getByRole('button', { name: 'Salir', exact: true }) as HTMLButtonElement
    await waitFor(() => expect(exit.disabled).toBe(false))
    fireEvent.click(exit)
    expect(screen.getByRole('tab', { name: 'Modelos activos' }).getAttribute('aria-selected')).toBe('false')
    expect(document.getElementById('provider-settings-panel-providers')).not.toBeNull()
    expect(mutations).toEqual([])
  })

  it('keeps Exit disabled while the model inventory is loading', async () => {
    let finish: (value: unknown) => void = () => { throw new Error('not started') }
    vi.stubGlobal('fetch', vi.fn(async (input: string) => {
      const url = String(input)
      if (url === '/api/providers/registry') return response({ registrations: [] })
      if (url === '/api/providers/ollama/status') return response({ state: 'not_configured' })
      if (url === '/api/providers/model-policy') return new Promise(resolve => { finish = resolve })
      throw new Error(`Unexpected request: ${url}`)
    }))
    const onExit = vi.fn()
    render(<ProviderSettings onExit={onExit} />)
    fireEvent.click(screen.getByRole('tab', { name: 'Modelos activos' }))
    const exit = screen.getByRole('button', { name: 'Salir', exact: true }) as HTMLButtonElement
    expect(exit.disabled).toBe(true)
    fireEvent.click(exit)
    expect(onExit).not.toHaveBeenCalled()
    finish(response(policy))
    await waitFor(() => expect(exit.disabled).toBe(false))
  })
})

describe('Provider settings behavior with simulated API responses', () => {
  it('marks Ollama as registered after saving its key even when no model is selected', async () => {
    let current = { state: 'not_configured', auth_mode: null as string | null, model_id: null as string | null }
    vi.stubGlobal('fetch', vi.fn(async (input: string, init?: RequestInit) => {
      const url = String(input)
      if (url === '/api/providers/registry') return response({ registrations: [] })
      if (url === '/api/providers/ollama/status') return response(current)
      if (url === '/api/providers/ollama/config' && init?.method === 'PUT') {
        const body = JSON.parse(String(init.body))
        expect(body.api_key).toBe('OLLAMA_KEY_FIXTURE')
        current = { state: 'configured_unverified', auth_mode: 'api_key', model_id: null }
        return response(current)
      }
      if (url === '/api/providers/ollama/models') return response({ models: Array.from({ length: 23 }, (_, index) => ({
        provider_id: 'ollama-cloud', model_id: `model-${index + 1}`, display_name: `Model ${index + 1}`,
      })) })
      throw new Error(`Unexpected request: ${url}`)
    }))

    render(<ProviderSettings />)
    const providerTab = screen.getByRole('tab', { name: /Ollama/ })
    await waitFor(() => expect(providerTab.className).toContain('unavailable'))
    fireEvent.change(screen.getByLabelText(/Clave API/, { selector: 'input[type=password]' }), { target: { value: 'OLLAMA_KEY_FIXTURE' } })
    fireEvent.click(screen.getByRole('button', { name: 'Guardar acceso', exact: true }))

    expect(await screen.findByText('Se encontraron 23 modelos. Comprueba el acceso al elegido.')).toBeTruthy()
    await waitFor(() => expect(providerTab.className).toContain('usable'))
    expect(within(providerTab).getByRole('status').getAttribute('aria-label')).toBe('REGISTRADO · ACTIVADO')
  })

  it.each(['changed', 'unchanged', 'save-failed', 'verify-failed'])('uses one Ollama action to save and verify (%s)', async scenario => {
    let current = { state: 'ready', auth_mode: 'api_key', model_id: 'model-a' }
    const mutations: Array<{ url: string; body: any }> = []
    vi.stubGlobal('fetch', vi.fn(async (input: string, init?: RequestInit) => {
      const url = String(input)
      if (init?.method === 'PUT' || init?.method === 'POST') mutations.push({ url, body: JSON.parse(String(init.body)) })
      if (url === '/api/providers/registry') return response({ registrations: [] })
      if (url === '/api/providers/ollama/status') return response(current)
      if (url === '/api/providers/ollama/models') return response({ models: ['model-a', 'model-b'].map(model_id => ({ provider_id: 'ollama-cloud', model_id, display_name: model_id })) })
      if (url === '/api/providers/ollama/config') {
        if (scenario === 'save-failed') return response({ detail: { message: 'No se pudo guardar el modelo.' } }, 503)
        current = { ...current, state: 'configured_unverified', model_id: JSON.parse(String(init?.body)).model_id }
        return response(current)
      }
      if (url === '/api/providers/ollama/verify') {
        if (scenario === 'verify-failed') return response({ detail: { message: 'Acceso rechazado.' } }, 401)
        current = { ...current, state: 'ready' }
        return response({ ...current, generation_performed: true })
      }
      throw new Error(`Unexpected request: ${url}`)
    }))
    render(<ProviderSettings />)
    await screen.findByText('Se encontraron 2 modelos. Comprueba el acceso al elegido.')
    fireEvent.click(within(screen.getByRole('tablist', { name: 'Configuración de Ollama' })).getByRole('tab', { name: 'Modelo', exact: true }))
    const panel = within(screen.getByRole('tabpanel', { name: 'Modelo', exact: true }))
    const selectedModel = scenario === 'unchanged' ? 'model-a' : 'model-b'
    fireEvent.change(panel.getByRole('combobox'), { target: { value: selectedModel } })
    expect(screen.queryByRole('button', { name: 'Guardar modelo', exact: true })).toBeNull()
    fireEvent.click(panel.getByRole('button', { name: 'Guardar y comprobar acceso', exact: true }))
    if (scenario === 'save-failed') await screen.findByText(/No se pudo guardar el modelo\./)
    else if (scenario === 'verify-failed') await screen.findByText(/Acceso rechazado\./)
    else await screen.findByText(`Acceso comprobado: ${selectedModel}.`)
    const save = '/api/providers/ollama/config', verify = '/api/providers/ollama/verify'
    expect(mutations.map(item => item.url)).toEqual(scenario === 'unchanged' ? [verify] : scenario === 'save-failed' ? [save] : [save, verify])
    if (scenario !== 'unchanged') expect(mutations[0].body).toEqual({ auth_mode: 'api_key', model_id: selectedModel })
    if (scenario.endsWith('failed')) expect(screen.queryByText(/^Acceso comprobado:/)).toBeNull()
  })

