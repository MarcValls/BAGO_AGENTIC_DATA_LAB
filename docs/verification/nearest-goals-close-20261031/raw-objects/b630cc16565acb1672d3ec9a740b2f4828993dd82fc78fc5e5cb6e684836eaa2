.evaluation-lab { color: #e4edf8; background: #0b1422; border: 1px solid #34485f; border-radius: 0; padding: 0; }
.eval-section-heading, .eval-cases-heading { display: flex; flex-wrap: wrap; min-width: 0; align-items: center; justify-content: space-between; gap: 16px; }
.eval-review > p:not(.eval-kicker) { color: #9bb0c9; }
.eval-kicker { color: #83addc; font-size: .75rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; margin: 0 0 7px; }
.evaluation-lab button, .evaluation-lab input, .evaluation-lab textarea, .evaluation-lab select { font: inherit; }
.evaluation-lab button { border: 1px solid #36516f; background: #15263b; color: #dcecff; border-radius: 0; padding: 9px 13px; cursor: pointer; }
.evaluation-lab button:hover:not(:disabled), .evaluation-lab button:focus-visible { border-color: #77a9df; outline: 2px solid #77a9df; outline-offset: 2px; }
.evaluation-lab button:disabled { opacity: .5; cursor: not-allowed; }
.eval-layout { display: grid; grid-template-columns: minmax(0, .3fr) minmax(0, 1fr); align-items: stretch; gap: 16px; padding: 16px; }
.eval-layout.suites-collapsed { grid-template-columns: 58px minmax(0, 1fr); }
.eval-suites, .eval-editor, .eval-review, .eval-results, .eval-selection { min-width: 0; box-sizing: border-box; overflow-wrap: anywhere; background: #101d2e; border: 1px solid #34485f; border-radius: 0; padding: 18px; }
.eval-suites.is-collapsed { padding: 8px; }
.eval-suites-heading { gap: 8px; }
.eval-suites-toggle { flex: 0 0 38px; min-height: 38px; padding: 4px !important; font-size: 1.35rem !important; line-height: 1; }
.eval-section-heading h3, .eval-editor h3, .eval-review h3, .eval-results h3 { margin: 2px 0 12px; }
.eval-suite-option, .eval-run-option { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; min-width: 0; max-width: 100%; box-sizing: border-box; text-align: left; margin: 8px 0; gap: 4px; }
.eval-suite-option > *, .eval-run-option > * { min-width: 0; max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
.eval-suite-option span, .eval-run-option span, .eval-run-option code { color: #9bb0c9; font-size: .82rem; }
.eval-suite-option.selected, .eval-run-option.selected { border-color: #7aaee5; background: #1b3552; }
.eval-empty, .eval-prerequisite { color: #a9bdd3; font-size: .9rem; line-height: 1.5; }
.eval-privacy-note { color: #f0cc83; background: #302817; border: 1px solid #69552c; border-radius: 0; padding: 10px 12px; font-size: .86rem; line-height: 1.45; }
.eval-history-heading { margin-top: 28px; border-top: 1px solid #263a52; padding-top: 15px; }
.eval-main { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
.eval-main > :is(.eval-editor, .eval-review, .eval-results, .eval-selection) { flex: 1; }
.eval-editor label, .eval-model-picker { display: grid; min-width: 0; gap: 7px; color: #b9cce0; margin: 12px 0; }
.eval-editor label small { color: #8da5bf; }
.eval-editor input, .eval-editor textarea, .eval-editor select, .eval-model-picker select { min-width: 0; color: #eaf3ff; background: #0b1422; border: 1px solid #36516f; border-radius: 0; padding: 10px; width: 100%; box-sizing: border-box; }
.eval-editor :focus-visible { outline: 2px solid #83b8f0; outline-offset: 2px; }
.eval-two-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
.eval-case { position: relative; min-width: 0; border: 1px solid #344a65; border-radius: 0; padding: 10px 14px; margin: 14px 0; }
.eval-case legend { color: #d9e9fb; font-weight: 700; padding: 0 7px; }
.eval-remove-case { position: absolute; right: 12px; top: -4px; font-size: .8rem !important; padding: 5px 8px !important; }
.eval-save, .eval-run-button { font-weight: 750 !important; background: #2a5c8b !important; }
.eval-cancel { margin-left: 8px; }
.eval-selection { display: flex; flex-direction: column; justify-content: center; border-top: 2px solid var(--adl-accent-blue, #6b9cc5); }
.eval-selection h3 { margin-top: 0; }
.eval-selection p { color: #a9bdd3; line-height: 1.5; }
.eval-suite-cases { margin: 14px 0; padding: 10px 12px; border: 1px solid #34485f; border-left: 3px solid #608bb7; }
.eval-suite-cases > summary { cursor: pointer; font-weight: 650; }
.eval-version { color: #9bb0c9; font-size: .85rem; }
.eval-review dl, .eval-run-identity { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 20px; }
.eval-review dl div, .eval-run-identity div { min-width: 0; }
.eval-review dt, .eval-run-identity dt { color: #8fa8c2; font-size: .82rem; }
.eval-review dd, .eval-run-identity dd { margin: 3px 0 0; overflow-wrap: anywhere; }
.eval-review > p:not(.eval-kicker) { font-size: .9rem; line-height: 1.5; }
.eval-results { overflow-wrap: anywhere; }
.eval-result-case { border-top: 1px solid #2a4059; margin-top: 14px; padding-top: 12px; }
.eval-result-case h4 { margin: 4px 0; }
.eval-result-case ul { padding-left: 20px; color: #b9cce0; }
.eval-result-case pre { white-space: pre-wrap; background: #0b1422; padding: 12px; border-radius: 0; max-height: none; overflow: auto; }
.eval-result-case a { color: #8bc2fa; }
.eval-state { border: 1px solid #80504a; border-radius: 0; padding: 14px; background: #281c21; }
.eval-state p { color: #e3b7b1; }
@media (max-width: 850px) { .eval-layout, .eval-layout.suites-collapsed { grid-template-columns: minmax(0, 1fr); } }
@media (max-width: 560px) { .eval-two-columns, .eval-review dl, .eval-run-identity { grid-template-columns: 1fr; } .eval-layout { padding: 10px; } }
.eval-layout, .eval-editor, .eval-results { min-height: 0; min-width: 0; }
