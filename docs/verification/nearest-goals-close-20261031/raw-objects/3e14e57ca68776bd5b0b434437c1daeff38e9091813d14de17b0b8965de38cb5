.cognition-settings { width: 100%; max-width: none; color: #c5d3e4; }
.cognition-settings > header:not(.workspace-heading) { margin: 4px 0 22px; padding: 4px 2px 16px; border-bottom: 1px solid #293b50; }
.cognition-settings > header:not(.workspace-heading) h3 { margin: 0 0 6px; color: #edf4ff; font-size: clamp(1.2rem, 2vw, 1.6rem); }
.cognition-settings > header:not(.workspace-heading) p { max-width: 76ch; margin: 0; color: #9fb1c6; }
.cognition-settings h3 { margin: 0 0 12px; color: #edf4ff; }
.cognition-settings p { line-height: 1.55; }
.cognition-mode { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 0 0 22px; padding: 18px; border: 1px solid #34465d; border-radius: 10px; background: #101d2d; }
.cognition-mode legend { padding: 0 8px; font-weight: 650; }
.cognition-mode label { display: flex; min-height: 84px; align-items: flex-start; gap: 12px; padding: 16px; border: 1px solid #2e435c; border-radius: 8px; background: #142338; cursor: pointer; }
.cognition-mode label:has(input:checked) { border-color: #5180b1; background: linear-gradient(135deg, #1b3551, #142338); box-shadow: inset 3px 0 #6eaff0; }
.cognition-mode label span { display: grid; gap: 7px; }
.cognition-mode label strong { color: #e6f1fc; font-size: .9rem; }
.cognition-mode input { margin-top: 4px; accent-color: #78b2f0; }
.cognition-mode small, .context-summary small { display: block; margin-top: 4px; color: #9fb1c6; line-height: 1.5; }
.cognition-note { font-size: .85rem; color: #9fb1c6; }
.cognition-status { padding: 9px 12px; border: 1px solid #397654; border-radius: 7px; color: #b7f0cd; background: #102a20; font-size: .85rem; }
.context-locations { margin-top: 20px; }
.context-locations > summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 9px 0; color: #b4c5d8; cursor: pointer; list-style: none; }
.context-locations > summary::-webkit-details-marker { display: none; }
.context-locations > summary::after { content: '+'; margin-left: auto; color: #8198b1; }
.context-locations[open] > summary::after { content: '−'; }
.context-locations > summary strong { font-size: .82rem; font-weight: 600; }
.context-locations > summary span { color: #7f96ae; font-size: .72rem; }
.context-locations > summary:focus-visible { outline: 2px solid #78b2f0; outline-offset: 3px; }
.context-locations-content { padding-top: 4px; }
.context-summary { display: grid; gap: 16px; }
.cognition-context { margin-top: 0; padding: 17px 18px; border: 1px solid #344b65; border-radius: 10px; background: linear-gradient(145deg, #132236, #0f1b2a); }
.cognition-context > summary { padding: 0 0 14px; border-bottom: 1px solid #2c4057; }
.cognition-context > summary strong { color: #e6f1fc; font-size: .96rem; }
.cognition-context .context-locations-content { padding-top: 14px; }
.cognition-context-intro { margin: 0 0 14px; color: #9fb1c6; font-size: .77rem; }
.cognition-context-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 0; }
.cognition-context-summary > div { min-width: 0; padding: 12px 14px; border: 1px solid #2e435b; border-radius: 7px; background: #0d1927; }
.cognition-context-summary dt { margin-bottom: 6px; color: #8fa7c0; font-size: .66rem; font-weight: 750; letter-spacing: .07em; text-transform: uppercase; }
.cognition-context-summary dd { margin: 0; color: #d7e5f4; font-size: .78rem; line-height: 1.5; overflow-wrap: anywhere; }
.cognition-context-summary dd code { color: #b9d6f5; font-size: .73rem; }
.cognition-context-summary dd small { display: block; margin-top: 5px; color: #91a6bd; font-size: .68rem; line-height: 1.45; }
.context-sources-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin: 20px 0 9px; }
.context-sources-heading h4 { margin: 0; color: #e5eef9; font-size: .83rem; }
.context-sources-heading span { color: #8197af; font-size: .66rem; }
.context-source-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 310px), 1fr)); gap: 9px; }
.context-source-grid .workspace-source { margin: 0; }
.context-source-grid .workspace-source p { margin: 7px 0 0; color: #91a6bd; font-size: .68rem; line-height: 1.45; }
.context-source-grid .workspace-source code { overflow-wrap: anywhere; white-space: normal; }
.context-summary dt { font-size: .8rem; color: #9fb1c6; }
.context-summary dd { margin: 6px 0 0; }
.context-summary code, .context-paths code { overflow-wrap: anywhere; font-size: .8rem; }
.context-paths { display: grid; gap: 10px; padding: 0; list-style: none; }
.context-paths li { padding: 14px; border: 1px solid #34465d; border-radius: 8px; transition: border-color .15s ease, box-shadow .15s ease; }
.context-paths li.context-path-present { border-color: #3ba66b; box-shadow: inset 3px 0 #3ba66b; }
.context-paths li.context-path-absent { border-color: #c45252; box-shadow: inset 3px 0 #c45252; }
.context-paths li > div { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 8px; }
.context-paths li span { font-size: .8rem; font-weight: 650; }
.context-path-present > div span { color: #8fe0ae; }
.context-path-absent > div span { color: #ff9b9b; }
.context-path-field { display: grid; gap: 6px; margin: 8px 0; color: #9fb1c6; font-size: .8rem; }
.context-path-field input { width: 100%; box-sizing: border-box; padding: 8px 10px; border: 1px solid #57708c; border-radius: 6px; background: #0c1725; color: #edf4ff; font: inherit; }
.context-path-field input:focus-visible { outline: 2px solid #78b2f0; outline-offset: 2px; }
.context-paths p { margin: 8px 0 0; font-size: .8rem; color: #9fb1c6; }
.context-paths .context-path-error { color: #ff9b9b; }
.cognition-settings button { padding: 8px 12px; border: 1px solid #57779e; border-radius: 6px; background: #20344e; color: #edf4ff; cursor: pointer; }
.cognition-settings button:focus-visible, .cognition-mode input:focus-visible { outline: 2px solid #78b2f0; outline-offset: 3px; }
.workspace-settings { width: min(100%, 980px); max-width: 980px; margin: 0 auto; padding: 24px; border: 1px solid #263a52; border-radius: 10px; background: #101c2a; }
.workspace-heading { margin-bottom: 22px; }
.workspace-heading h3 { margin: 0; font-size: 1.3rem; }
.workspace-picker { padding: 0; }
.workspace-picker > label { display: block; margin-bottom: 8px; color: #e4effc; font-size: .84rem; font-weight: 700; }
.workspace-path-row { display: flex; gap: 8px; }
.workspace-path-row input { min-width: 0; flex: 1; padding: 11px 12px; border: 1px solid #47627e; border-radius: 8px; background: #09131f; color: #eaf3ff; font: .84rem ui-monospace, SFMono-Regular, Consolas, monospace; }
.workspace-path-row input:focus-visible { outline: 2px solid #78b2f0; outline-offset: 2px; }
.workspace-path-row button { white-space: nowrap; border-color: #456589; background: #1b3552; }
.workspace-path-row .workspace-browse { background: #294b70; }
.workspace-picker .cognition-status { margin: 8px 0 0; padding: 0; border: 0; background: none; font-size: .74rem; }
.workspace-picker .context-path-error { margin: 8px 0 0; }
.workspace-context { margin-top: 24px; }
.workspace-section-title { margin: 0 0 10px; color: #c9d9eb; font-size: .8rem; font-weight: 650; }
.workspace-sources { display: grid; gap: 7px; }
.workspace-memory { margin-top: 24px; padding-top: 17px; border-top: 1px solid #293d53; }
.workspace-memory dl { display: flex; flex-wrap: wrap; gap: 12px 32px; margin: 0; }
.workspace-memory dl > div { display: flex; align-items: baseline; gap: 10px; font-size: .78rem; }
.workspace-memory dt { color: #a2b6cc; }
.workspace-memory dd { margin: 0; font-size: .72rem; }
.workspace-memory .available { color: #8fe0ae; }
.workspace-memory .unavailable { color: #9aaabc; }
.workspace-source { min-width: 0; padding: 9px 11px; border: 1px solid #31485f; border-radius: 8px; background: #0c1724; }
.workspace-source > div { display: flex; justify-content: space-between; gap: 10px; color: #c8d7e8; font-size: .75rem; }
.workspace-source > div span { color: #8fe0ae; font-size: .7rem; }
.workspace-source.absent > div span { color: #ffaf9f; }
.workspace-source code { display: block; margin-top: 6px; overflow: hidden; color: #89a2bc; font-size: .68rem; text-overflow: ellipsis; white-space: nowrap; }
.project-document { border-left: 3px solid #557da6; }
.project-document[open] { border-color: #557da6; }
.context-source-grid > .project-document[open] { grid-column: 1 / -1; }
.project-document > summary { display: flex; min-height: 30px; align-items: center; gap: 9px; color: #dce9f7; cursor: pointer; list-style: none; }
.project-document > summary::-webkit-details-marker { display: none; }
.project-document > summary::before { content: '›'; color: #96bfe9; font-size: 1.3rem; }
.project-document[open] > summary::before { transform: rotate(90deg); }
.project-document > summary strong { flex: 1; font-size: .8rem; }
.project-document > summary > span { color: #8fe0ae; font-size: .7rem; }
.project-document.absent > summary > span { color: #ffaf9f; }
.project-document > summary:focus-visible, .project-document-content summary:focus-visible { outline: 2px solid #78b2f0; outline-offset: 3px; }
.project-document .project-document-path { white-space: normal; overflow-wrap: anywhere; }
.project-document > .project-document-content { display: block; min-width: 0; margin-top: 12px; padding-top: 10px; border-top: 1px solid #293f56; color: #c8d7e8; font-size: .8rem; }
.project-document-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 10px; color: #8fa7c0; font-size: .7rem; }
.project-document-toolbar button { padding: 5px 9px; font-size: .7rem; }
.project-document .project-document-toolbar > span { color: #8fa7c0; }
.project-document-content p, .project-document-content li { overflow-wrap: anywhere; white-space: pre-wrap; line-height: 1.6; }
.project-document-content p { margin: 8px 0; }
.project-document-content code { display: inline; margin: 0; color: #b8d8fa; font-size: .74rem; white-space: pre-wrap; overflow-wrap: anywhere; }
.project-document-content pre { max-width: 100%; margin: 9px 0; padding: 11px; border-radius: 5px; background: #09121e; color: #c3d8ee; font: .73rem/1.6 ui-monospace, SFMono-Regular, Consolas, monospace; white-space: pre-wrap; overflow-wrap: anywhere; }
.project-document-section { min-width: 0; margin: 9px 0; padding: 8px 11px; border: 1px solid #2d435a; border-left: 3px solid #4d739b; border-radius: 5px; background: #101d2c; }
.project-document-section > summary { color: #d9eafb; font-size: .79rem; font-weight: 650; cursor: pointer; overflow-wrap: anywhere; }
.project-json-tree { margin: 0; }
.project-json-tree > div { display: grid; min-width: 0; grid-template-columns: minmax(100px, .35fr) minmax(0, 1fr); gap: 10px; padding: 8px 0; border-bottom: 1px solid #23364b; }
.project-json-tree > div:last-child { border-bottom: 0; }
.project-json-tree dt { color: #96b8dc; font: .73rem/1.6 ui-monospace, SFMono-Regular, Consolas, monospace; overflow-wrap: anywhere; }
.project-json-tree dd { min-width: 0; margin: 0; color: #d9e5f4; white-space: pre-wrap; overflow-wrap: anywhere; }
.project-json-tree dd > .project-document-section { margin: 0; }
.project-document .project-json-string { color: #d9e5f4; }
.project-document .project-json-boolean, .project-document .project-json-number { color: #94dfbd; }
.project-document-raw { margin-top: 15px; color: #91a9c3; }
.project-document-raw > summary { cursor: pointer; font-size: .72rem; }
@media (max-width: 640px) { .project-json-tree > div { grid-template-columns: minmax(0, 1fr); gap: 4px; } .project-document-section { padding: 8px; } }
.workspace-context details > summary { cursor: pointer; }
@media (max-width: 640px) { .workspace-settings { padding: 16px; } .workspace-path-row { flex-wrap: wrap; } .workspace-path-row input { flex-basis: 100%; } .workspace-path-row button { flex: 1; } }
@media (max-width: 760px) { .cognition-mode, .cognition-context-summary { grid-template-columns: minmax(0, 1fr); } .cognition-mode label { min-height: 0; } .cognition-context { padding: 13px; } }
