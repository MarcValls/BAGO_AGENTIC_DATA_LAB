.agent-task-form { display: grid; gap: 7px; min-width: 0; }
.agent-task-form textarea, .agent-task-form input { box-sizing: border-box; width: 100%; min-width: 0; background: var(--surface-input, #0b1522); color: inherit; border: 1px solid var(--border-color, #344c63); border-radius: 5px; padding: 9px; font: inherit; }
.agent-task-form textarea { resize: vertical; min-height: 100px; }
.agent-task-form label { font-size: .9rem; }
.agent-task-dates { margin-top: 5px; border-left: 3px solid #4b8aa8; padding-left: 10px; }
.agent-task-dates summary { cursor: pointer; padding: 6px 0; }
.agent-task-dates summary span { font-size: .8rem; margin-left: 5px; opacity: .65; }
.agent-task-date { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(145px, 1fr) auto; gap: 8px; align-items: end; margin: 8px 0; }
.agent-task-date label { display: grid; gap: 4px; min-width: 0; }
.agent-task-date button { align-self: end; height: 38px; }
.agent-task-dates-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin: 8px 0; }
.agent-task-dates-actions small { opacity: .7; }
@media (max-width: 600px) { .agent-task-date { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
