def parse_soft_skills() -> list[list[str]]:
    """Extract the strategic/soft skill table from .bago/canon/JOB_SKILL_MATRIX.md."""
    text = (REPO_ROOT / ".bago/canon/JOB_SKILL_MATRIX.md").read_text(encoding="utf-8")
