            f"| {item['order_id']} | {_cell(order.get('shipping_method', 'desconocido'))} | "
            f"{delay_text} | `{item['decision']}` | {amount_text} |"
        )

    runs = run_data.get("runs", [])
    trace_ids = [
        run.get("trace", {}).get("trace_id", "")
        for run in runs
