old=subprocess.run(['git','show','f253f3700990943755e63717a93d3be99f0e19fa:README.md'],cwd=W,capture_output=True,text=True,encoding='utf-8',check=True).stdout
def links(body):return set(re.findall(r'(?<!!)\[[^\]]+\]\(([^)]+)\)',body))
new_local=[]
for link in sorted(links(text)-links(old)):
    if '://' in link or link.startswith('#'):continue
