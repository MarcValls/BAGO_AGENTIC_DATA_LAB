"""Snapshot authorized sources and generate a preview; the suite is NOT_RUN."""
from pathlib import Path
import ast
import argparse
import datetime
import hashlib
import importlib.util
import json
import os
import shutil
import subprocess

HERE = Path(__file__).resolve().parent
G = HERE.parents[1]
R = G.parents[2]
W = R / '.worktrees/readme-clarity-20261022'
parser = argparse.ArgumentParser()
parser.add_argument('--attempt', default='2')
args = parser.parse_args()
tag = 'attempt-' + args.attempt
LOGS = HERE / tag
LOGS.mkdir(exist_ok=False)
F = G / 'fixtures/B01' / tag
D = G / 'deliveries/B01' / tag
F.mkdir(parents=True, exist_ok=True)
D.mkdir(parents=True, exist_ok=True)
SOURCES = ('scripts/generate_dynamic_readme.py', 'docs/readme_manifest.json', 'docs/readme_generation.md')


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def save(path, value):
    path.write_text(json.dumps(value, indent=2, ensure_ascii=False) + '\n', encoding='utf-8')


rows = []
for rel in SOURCES:
    source = W / rel
    target = D / rel
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, target)
    assert sha(source) == sha(target)
    rows.append({'path': rel, 'delivery': target.relative_to(G).as_posix(), 'target': str(source), 'sha256': sha(source)})
ast.parse((W / SOURCES[0]).read_bytes(), filename=str(W / SOURCES[0]))
save(D / 'MANIFEST.json', {'state': 'PREPARED', 'candidate_base': 'f253f3700990943755e63717a93d3be99f0e19fa', 'files': rows})
(F / 'README.before.md').write_bytes((W / 'README.md').read_bytes())
host = F / 'host'
for name in ('local', 'roaming', 'home', 'temp', 'workspace'):
    (host / name).mkdir(parents=True, exist_ok=True)
workspace = host / 'local/BAGO/AgenticDataLab/workspace.json'
workspace.parent.mkdir(parents=True, exist_ok=True)
save(workspace, {'workspace_root': str(host / 'workspace')})
overrides = {'PYTHONDONTWRITEBYTECODE': '1', 'PYTHONIOENCODING': 'utf-8',
    'PYTHONPATH': os.pathsep.join([str(R / 'output/teamctl-p1-deps-20261022'), str(R / 'output/rd142-deps')]),
    'LOCALAPPDATA': str(host / 'local'), 'APPDATA': str(host / 'roaming'), 'HOME': str(host / 'home'),
    'USERPROFILE': str(host / 'home'), 'TEMP': str(host / 'temp'), 'TMP': str(host / 'temp'),
    'BAGO_CONVERSATION_DB_PATH': str(host / 'conversations.sqlite3'), 'BAGO_OTEL_EXPORTER_OTLP_ENDPOINT': ''}
env = dict(os.environ, **overrides)
argv = [str(R / '.venv/Scripts/python.exe'), '-B', 'scripts/generate_dynamic_readme.py', '--skip-tests']
started = datetime.datetime.now(datetime.timezone.utc).isoformat()
call = subprocess.run(argv, cwd=W, env=env, capture_output=True, timeout=300)
(LOGS / 'preview.stdout.log').write_bytes(call.stdout)
(LOGS / 'preview.stderr.log').write_bytes(call.stderr)
receipt = {'argv': argv, 'cwd': str(W), 'exit_code': call.returncode, 'started_at': started,
    'finished_at': datetime.datetime.now(datetime.timezone.utc).isoformat(), 'environment': overrides,
    'stdout_sha256': sha(LOGS / 'preview.stdout.log'), 'stderr_sha256': sha(LOGS / 'preview.stderr.log')}
save(LOGS / 'preview-receipt.json', receipt)
if call.returncode:
    print(call.stdout.decode('utf-8', errors='replace'))
    print(call.stderr.decode('utf-8', errors='replace'))
    raise SystemExit(call.returncode)
assert 'suite NOT_RUN' in call.stdout.decode('utf-8')
assert all(sha(W / row['path']) == sha(G / row['delivery']) == row['sha256'] for row in rows)
spec = importlib.util.spec_from_file_location('readme_preview_check', W / SOURCES[0])
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
manifest = module._read_json(module.MANIFEST_PATH)
state = module.parse_state()
zero = module.render_readme(manifest=manifest, state=state, passing_tests=0)
different_count = module.render_readme(manifest=manifest, state=state, passing_tests=987654321)
assert zero == different_count == (W / 'README.md').read_text(encoding='utf-8')
(F / 'README.preview.md').write_text(zero, encoding='utf-8', newline='\n')
save(LOGS / 'build-result.json', {'result': 'PASS', 'checks': ['AST syntax', '3 source snapshots match worktree', 'preview generated by --skip-tests', 'passing_tests does not affect render'],
    'preview': {'path': (F / 'README.preview.md').relative_to(G).as_posix(), 'sha256': sha(F / 'README.preview.md'), 'lines': len(zero.splitlines())},
    'source_manifest': (D / 'MANIFEST.json').relative_to(G).as_posix(), 'command': receipt,
    'suite_execution': 'NOT_RUN', 'ci_snapshot_is_predecessor': True, 'native_agents': 'USED_BY_COORDINATOR', 'spiral_engine': 'NOT_RUN'})
print(json.dumps({'result': 'PASS', 'suite_execution': 'NOT_RUN', 'preview_lines': len(zero.splitlines()), 'source_files': len(rows)}))
