{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bago://adl/team/handoff.v3.schema.json",
  "type": "object",
  "required": [
    "work_id",
    "role",
    "status",
    "mission_id",
    "candidate_id",
    "scope_sha256",
    "changed_files",
    "outputs",
    "verification",
    "residual_risks",
    "next_consumers",
    "payload_sha256"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "uniqueItems": true
    }
  },
  "properties": {
    "work_id": {
      "$ref": "#/$defs/text"
    },
    "role": {
      "$ref": "#/$defs/text"
    },
    "status": {
      "const": "DONE"
    },
    "mission_id": {
      "$ref": "#/$defs/text"
    },
    "candidate_id": {
      "$ref": "#/$defs/digest"
    },
    "scope_sha256": {
      "$ref": "#/$defs/digest"
    },
    "changed_files": {
      "$ref": "#/$defs/paths"
    },
    "reviewed_paths": {
      "$ref": "#/$defs/paths"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "anyOf": [
          {
            "required": [
              "kind"
            ]
          },
          {
            "required": [
              "id",
              "frozen"
            ]
          }
        ],
        "properties": {
          "kind": {
            "$ref": "#/$defs/text"
          },
          "id": {
            "$ref": "#/$defs/text"
          },
          "frozen": {
            "type": "boolean"
          },
          "path": {
            "$ref": "#/$defs/text"
          },
          "sha256": {
            "$ref": "#/$defs/digest"
          }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "command",
          "result",
          "evidence",
          "execution_id"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "command": {
            "$ref": "#/$defs/text"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "execution_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "enum": [
                    "PASS",
                    "FAIL"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "$ref": "#/$defs/text"
                },
                "execution_id": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "scope",
          "status",
          "affects_correction"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "scope": {
            "enum": [
              "PRODUCT",
              "EVIDENCE",
              "COVERAGE"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "CLOSED"
            ]
          },
          "affects_correction": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_consumers": {
      "$ref": "#/$defs/paths"
    },
    "payload_sha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "additionalProperties": false
}
